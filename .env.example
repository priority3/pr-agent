# ── 数据库(单用户单文件本地库)──
DATABASE_URL=file:./data/pr.db

# ── 管理端会话 ──
ADMIN_PASSWORD=change-me
ADMIN_SESSION_SECRET=replace-with-a-long-random-string
SETTINGS_ENCRYPTION_KEY=replace-with-a-long-random-string

# ── AI 网关(Anthropic 协议为主链路;OpenAI 兼容为备用)──
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=
ANTHROPIC_MODEL=
ANTHROPIC_VISION_MODEL=
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=
OPENAI_API_FORMAT=chat

# ── PR agent ──
PR_CHAT_TOKEN=replace-with-a-token
PR_CHAT_MAX_TOKENS=2000
PR_MEMORY_DECAY_DAYS=
PR_MEMORY_RECONCILE_APPLY=
PR_REVIEW_MODEL=
PR_REVIEW_PROVIDER=
PR_UPLOAD_DIR=./data/uploads
# RAG 向量检索(留空 = 纯 BM25 lexical)
PR_EMBEDDING_API_KEY=
PR_EMBEDDING_BASE_URL=
PR_EMBEDDING_MODEL=

# ── 数据摄入 ──
HEALTH_IMPORT_TOKEN=replace-with-a-token
