# ── 数据库(单用户单文件本地库)──
DATABASE_URL=file:./data/pr.db

# ── 管理端会话 ──
ADMIN_PASSWORD=change-me
ADMIN_SESSION_SECRET=replace-with-a-long-random-string
SETTINGS_ENCRYPTION_KEY=replace-with-a-long-random-string

# ── AI 网关(Anthropic 协议为主链路;OpenAI 兼容为备用)──
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=
ANTHROPIC_MODEL=
ANTHROPIC_VISION_MODEL=
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=
OPENAI_API_FORMAT=chat

# ── PR agent ──
PR_CHAT_TOKEN=replace-with-a-token
PR_CHAT_MAX_TOKENS=2000
PR_MEMORY_DECAY_DAYS=
PR_MEMORY_RECONCILE_APPLY=
PR_REVIEW_MODEL=
PR_REVIEW_PROVIDER=
PR_UPLOAD_DIR=./data/uploads
# RAG 向量检索(留空 = 纯 BM25 lexical)
PR_EMBEDDING_API_KEY=
PR_EMBEDDING_BASE_URL=
PR_EMBEDDING_MODEL=

# ── 数据摄入 ──
# 通用导入端点 POST /api/activities/import 与健康上报共用这把 token(或 admin 会话)。
HEALTH_IMPORT_TOKEN=replace-with-a-token
# 可选数据源(默认关):Keep / Strava。配了对应凭据后,调度器每小时增量拉取。
# SYNC_SOURCE 决定调度器同步哪个源(keep | strava,默认 keep)。
# SYNC_SOURCE=keep
# KEEP_MOBILE=
# KEEP_PASSWORD=
# STRAVA_CLIENT_ID=
# STRAVA_CLIENT_SECRET=
# STRAVA_REFRESH_TOKEN=
# 富化开关(默认关):天气(open-meteo,keyless);赛事匹配依赖 Playwright,standalone 未打包(置开仅告警)。
# ENRICH_WEATHER=false
# ENRICH_RACE_MATCH=false

# ── 通知(可选)──
# PUSHPLUS_TOKEN=

# ── 可观测(可选,留空则 tracing no-op 零开销)──
# PHOENIX_COLLECTOR_ENDPOINT=
# PHOENIX_PROJECT_NAME=running-companion
# PHOENIX_API_KEY=
