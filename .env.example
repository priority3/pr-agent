# ─────────────────────────────────────────────────────────────
# PR Agent 环境变量(单用户自部署)。
# 用法:cp .env.example .env,填必填项(标 ★),其余留空即用默认 / 降级。
# 敏感项一律占位空;所有 key 均由 server/lib/config.ts 从 process.env 读取。
# ─────────────────────────────────────────────────────────────

# ── 数据库(单用户单文件本地库)──
# ★ 默认本地 SQLite 单文件;换远程 libsql/Turso 时填 libsql:// URL + 下面的 AUTH_TOKEN。
DATABASE_URL=file:./data/pr.db
# 远程 libsql/Turso 鉴权 token(本地 file: 库无需填)。
DATABASE_AUTH_TOKEN=

# ── 管理 API 鉴权(无内置界面;管理端点靠会话 cookie 保护)──
# ★ 管理 API 登录口令(POST /api/auth/login 换会话 cookie)。
ADMIN_PASSWORD=change-me
# ★ 会话 cookie HMAC 密钥(长随机串);未设则回退用 SETTINGS_ENCRYPTION_KEY。
ADMIN_SESSION_SECRET=replace-with-a-long-random-string
# 通用加密 / 密钥兜底(长随机串)。
SETTINGS_ENCRYPTION_KEY=replace-with-a-long-random-string

# ── AI 网关(Anthropic 协议为主链路;OpenAI 兼容为备用)──
# ★ 主链路:Anthropic 协议(工具循环 / 图片 / 提示缓存均走这条)。BASE_URL 留空 = 官方端点。
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=
ANTHROPIC_MODEL=
# 带图请求切到的视觉模型(主力模型不支持图片时用);留空则始终用 ANTHROPIC_MODEL。
ANTHROPIC_VISION_MODEL=
# 备用链路:OpenAI 兼容网关(未配 ANTHROPIC_API_KEY 时降级到这条)。
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=
# OpenAI 请求格式:chat(默认)| responses。
OPENAI_API_FORMAT=chat

# ── PR agent ──
# ★ H5 对话页访问令牌(/pr?t=<token> 免登录进入;也用于推送链接)。
PR_CHAT_TOKEN=replace-with-a-token
# 单次对话生成 token 预算(默认 2000;thinking 型模型建议 ≥2000)。
PR_CHAT_MAX_TOKENS=2000
# 长期记忆新鲜度衰减窗口(天);留空用内置默认。
PR_MEMORY_DECAY_DAYS=
# 记忆调和是否落库(1/true 开启;留空 = 仅演练不写)。
PR_MEMORY_RECONCILE_APPLY=
# 跑后复盘所用模型 / 提供方(留空则复用主链路模型)。
PR_REVIEW_MODEL=
PR_REVIEW_PROVIDER=
# 上传图片落盘目录。
PR_UPLOAD_DIR=./data/uploads
# 数据保留清理窗口(天),retention_cleanup 定时任务用;默认 90。
PR_RETENTION_DAYS=
# 数字分身投影的 LLM 蒸馏路开关(off = 只跑确定性投影,不产生模型调用;留空 = 开启)。
# 蒸馏只在已生效记忆集合变化时才实际调模型,失败自动沿用上一版结果。
PR_PERSONA_LLM=

# ── RAG 向量检索(留空 = 纯 BM25 lexical,无需任何 embedding 服务)──
PR_EMBEDDING_API_KEY=
PR_EMBEDDING_BASE_URL=
PR_EMBEDDING_MODEL=

# ── 数据摄入 & 数据源 ──
# ★ 健康 / 活动上报入口 token:POST /api/health/daily 与 POST /api/activities/import 共用
#    (Bearer;也接受管理端会话 cookie)。iOS「健康」快捷指令用此 token 上报。
HEALTH_IMPORT_TOKEN=replace-with-a-token
# 调度器每小时增量同步的数据源(keep | strava);留空 = 不启用自动同步。
SYNC_SOURCE=
# 可选数据源凭据(仅当启用对应源时需要):
# Keep(需 KEEP_MOBILE + KEEP_PASSWORD)。
KEEP_MOBILE=
KEEP_PASSWORD=
# Strava(需 CLIENT_ID + CLIENT_SECRET + REFRESH_TOKEN)。
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=
STRAVA_REFRESH_TOKEN=

# ── 富化开关(默认关,避免每次同步打外部)──
# 天气(open-meteo,keyless);仅室外活动生效。
ENRICH_WEATHER=false
# 赛事名称匹配依赖 Playwright,standalone 未打包;置开仅告警不生效。
ENRICH_RACE_MATCH=false

# ── 通知(可选,China-only 微信 / 邮件 / 短信推送)──
# 留空 = 无可用渠道,派发器优雅跳过(不报错)。
PUSHPLUS_TOKEN=
# 推送链接前缀:PUBLIC_BASE_URL + /pr?t=PR_CHAT_TOKEN;留空则用相对路径。
PUBLIC_BASE_URL=

# ── 可观测(可选;需自行注册 OpenTelemetry SDK provider 才生效)──
# 未接 provider 时 tracing 为 no-op、零开销;接入 Phoenix / OTLP 收集器时按需填。
PHOENIX_COLLECTOR_ENDPOINT=
PHOENIX_PROJECT_NAME=running-companion
PHOENIX_API_KEY=

# ── 调度总开关(可选;默认开启)──
# off / false / 0 = 一个定时任务都不注册,本进程只当 HTTP + agent 服务。
# 与宿主(如 runPaceFlow-admin)共用同一个库部署时**必须设成 off**:宿主那边已在跑同一批任务,
# 两边都跑会把同一份数据复盘两遍、通知推两次。独立自部署留空(=开启)。
PR_SCHEDULER=

# ── 调度 cron 覆盖(可选;覆盖对应定时任务的默认 cron,非法表达式忽略)──
# CRON_PR_DAILY_REVIEW=0 12 * * *
# CRON_WEEKLY_REVIEW=0 20 * * 0
# CRON_FRIEND_DIARY=31 21 * * 0
# CRON_MEMORY_MAINTENANCE=33 3 * * *
# CRON_PERSONA_PROJECTION=47 3 * * *
# CRON_NOTIFICATION_DISPATCH=*/10 * * * *
# CRON_RETENTION_CLEANUP=0 3 * * 0
# CRON_SYNC=0 * * * *

# ── 运行时(通常由容器 / docker-compose 注入,本地可覆盖)──
# PORT=3030
# NODE_ENV=production

# ── 评测(可选,仅本地 / CI 测试用;见 scripts/eval/README.md)──
# 注入环境感知 fixture,隔离评测不依赖真实外网(JSON 字符串);评测 runner 会自动注入。
# PR_ENV_FIXTURE_JSON=
# 评测隔离库路径(默认 file:./data/eval.db;必须是本地 file: 库且不能是 pr.db)。
# PR_EVAL_DATABASE_URL=
# 评测报告输出目录(默认 ./eval-runs)。
# PR_EVAL_OUT_DIR=
# 评测入口 run.sh 读取的 env-file 路径(默认 .env)。
# PR_EVAL_ENV=
